# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# Matched by pattern rather than enumerated: the previous list named five exact
# filenames, so a future .env.production or .env.staging would have been
# tracked by default.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/*.db
prisma/*.db-journal

# Playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# Throwaway verification scripts written against one deployment, with
# hard-coded ids and account passwords passed on the command line. Useful for
# ten minutes, misleading in a repository.
*.local.mjs
*.local.ts
