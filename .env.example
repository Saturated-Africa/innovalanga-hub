DATABASE_URL="postgresql://user:password@localhost:5432/innovalanga_hub"
NEXTAUTH_SECRET="your-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

AWS_S3_BUCKET=""
AWS_REGION="us-east-1"

RESEND_API_KEY=""

ENCRYPTION_KEY="32-char-hex-key-for-aes-256-here"


CRON_SECRET="your-cron-secret"

# AI assistant (Claude API). Without this the assistant is hidden and the
# route returns 503; the rest of the app is unaffected.
ANTHROPIC_API_KEY=sk-ant-...

# Inference provider: bedrock | ollama | anthropic. Unset disables the
# assistant entirely (launcher hidden, route returns 503).
AI_PROVIDER="bedrock"
# Optional model override. On af-south-1, Bedrock serves Claude 4.5 only via
# GLOBAL inference profiles. Confirm the exact id for your account with:
#   aws bedrock list-inference-profiles --region af-south-1
AI_MODEL=""
# Only used when AI_PROVIDER=ollama.
OLLAMA_BASE_URL=""

# Transactional email sender. Must be a domain verified in Resend with SPF and
# DKIM records we control. Defaults to noreply@innovalanga.co.za.
EMAIL_FROM=""

# The restricted database role used to serve programme data.
#
# Row-level security only enforces against a role that owns nothing and cannot
# bypass it, so this is a different role from DATABASE_URL rather than the same
# one twice. It is generated on the instance by infra/deploy.sh and written
# here automatically; there is nothing to fill in by hand.
#
# DATABASE_URL remains the owning connection: it runs migrations and serves
# sign-in, the scheduled job and user administration, none of which have a
# programme to be scoped to.
APP_DATABASE_URL=

# Where the database files live.
#
# Empty means the named docker volume on the instance's root disk, which is
# deleted when the instance is replaced. Set to the mount point of the retained
# EBS volume (/var/lib/innovalanga/pgdata) so the data outlives the instance.
POSTGRES_DATA_PATH=
