{
  "name": "innovalanga-hub",
  "version": "1.0.0",
  "description": "TIA & DSTI Innovation Progress Tracker",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate",
    "db:migrate-event-colors": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/migrate-event-colors.ts",
    "test:scope": "node --test --experimental-strip-types lib/scope.test.ts",
    "test:tenancy": "node --test --experimental-strip-types lib/tenancy.test.ts",
    "test": "node --test --experimental-strip-types lib/*.test.ts"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@hookform/resolvers": "^3.10.0",
